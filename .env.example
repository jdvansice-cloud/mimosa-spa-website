# ===========================================
# Mimosa Spa Website - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Google Tag Manager
# Get your GTM ID from https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mindbody API
MINDBODY_API_KEY=your-mindbody-api-key
MINDBODY_SITE_ID=your-site-id

# Attendance email ingest (NGTeco TC7 scheduled Time Card report → Gmail)
# App password: Google account → Security → 2-Step Verification → App passwords
ATTENDANCE_GMAIL_USER=spa-inbox@gmail.com
ATTENDANCE_GMAIL_APP_PASSWORD=your-16-char-app-password
# Optional: substring matched against sender/subject (default "ngteco")
# ATTENDANCE_EMAIL_FROM=ngteco
TV_AGENDA_TOKEN=

# WATI AI receptionist "Camila" (see docs/WATI_AGENT.md)
ANTHROPIC_API_KEY=your-anthropic-api-key
# openssl rand -hex 24
WATI_AGENT_WEBHOOK_SECRET=
# Email of the "Asistente Mimosa" WATI seat
WATI_AGENT_OPERATOR_EMAIL=
# Chatbot id of the WATI handoff flow
WATI_HANDOFF_CHATBOT_ID=
# Emails of the "Citas Costa del Este" / "Citas San Francisco" WATI users (handoff fallback)
WATI_CITAS_CDE_EMAIL=
WATI_CITAS_SFC_EMAIL=
# Business WhatsApp number, digits only
WATI_CHANNEL_PHONE=
# off | shadow | whitelist | live
WATI_AGENT_MODE=off
# Comma-separated phones, used only in whitelist mode
WATI_AGENT_WHITELIST=
# Defaults to claude-sonnet-5 if unset
WATI_AGENT_MODEL=
