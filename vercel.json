{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-appointments",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/sync-giftcards",
      "schedule": "15 * * * *"
    }
  ]
}
