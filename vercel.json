{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-appointments",
      "schedule": "45 * * * *"
    },
    {
      "path": "/api/cron/sync-giftcards",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/sync-kpis",
      "schedule": "30 12-23,0-2 * * *"
    },
    {
      "path": "/api/cron/giftcard-orders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/attendance-email",
      "schedule": "0 11,19 * * *"
    }
  ]
}