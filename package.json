{
  "name": "mimosa-spa-website",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "test:watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest",
    "type-check": "tsc --noEmit",
    "check-all": "npm run lint && npm run type-check",
    "verify": "npm run build",
    "wati:mine": "node --env-file=.env.local --experimental-strip-types --import ./scripts/spikes/ts-resolve-register.mjs scripts/wati-agent/mine-chats.ts",
    "wati:mine": "node --env-file=.env.local --experimental-strip-types --import ./scripts/spikes/ts-resolve-register.mjs scripts/wati-agent/mine-chats.ts",
    "wati:redact": "node --env-file=.env.local --experimental-strip-types --import ./scripts/spikes/ts-resolve-register.mjs scripts/wati-agent/redact-names.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.48.0",
    "@vercel/functions": "^3.9.5",
    "framer-motion": "^11.15.0",
    "imapflow": "^1.7.0",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.469.0",
    "mailparser": "^3.9.15",
    "next": "16.1.1",
    "next-intl": "^4.7.0",
    "qz-tray": "^2.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/qz-tray": "^2.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
